    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text\nconst maxSize = 10000;   // 10k caracteres\n\n\nlet chunk = \"\";\n\n// Si no hay texto, devolver un chunk con \"imagen\"\nif (text.trim().length === 0) {\n  chunk = `Title: ${title}\\n\\nimagen`;\n} else {\n  // Recortar el texto a máximo 10k caracteres\n  const trimmedText = text.slice(0, maxSize);\n  chunk =trimmedText\n}\n\n// Devolver un solo chunk\nreturn [{ json: { chunk } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2448,
        -176
      ],
      "id": "4dbb2bee-561a-4321-981f-eba96d41a8bf",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const text = $json[\"stdout\"] || \"\";\n\n// Dividir por saltos de línea y limpiar espacios vacíos\nconst lines = text\n  .split('\\n')\n  .map(line => line.trim())\n  .filter(line => line !== \"\");\n\n// Convertir cada línea en un chunk\nconst chunks = lines.map(line => ({ chunk: line }));\n\n// Retornar en formato que n8n espera\nreturn chunks.map(c => ({ json: c }));\n"
      },
