      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Procesamos cada resumen\nconst merged = items.map((item, index) => {\n  // Limpiar saltos de línea y espacios extra\n  const cleanText = item.json.output.replace(/\\n+/g, ' ').trim();\n  \n  return `Resumen ${index + 1}: ${cleanText}`;\n});\n\n// Unimos todo en un solo texto\nconst finalText = merged.join(\"\\n\\n\");\n\n// Extraemos datos de otra etapa\nconst title = $('Code in JavaScript').first().json.Title;\nconst customPath =$('Code in JavaScript').first().json.Path;\nconst num_p=  $('Code in JavaScript').first().json.numpages;\n\nreturn [{\n  json: {\n    Title: title,\n    CustomPath: customPath,\n    numPage:num_p,\n    mergedSummaries: finalText\n  }\n}];\n"
      },
