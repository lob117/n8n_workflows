    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const customPath = item.json.CustomPath;\n  const summaries = item.json.mergedSummaries;\n  const title = item.json.Title;\n  const numpage = item.json.numPage;\n\n  // Reemplazar espacios en el título por \"_\"\n  const cleanTitle = title?.replace(/\\s+/g, '_');\n\n  // Unimos en un solo texto\n  const mergedText = `${customPath}\\n\\n${summaries}`;\n\n  return {\n    json: {\n      fileText: mergedText,\n      fileTitle: cleanTitle\n    }\n  };\n});\n"
      },
