      ],
      "id": "280103dc-b6cb-4e27-a0e5-56d7f47a65af",
      "name": "Execute Command"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const numpages = item.json.numpages;\n  const path = item.json.info.Custom.Custom_Path;\n\n  // Extraer el último segmento del path (nombre del archivo)\n  const fileName = path.split('/').pop() || \"\";\n\n  // Quitar extensión .pdf, eliminar solo los paréntesis y limpiar espacios\n  const cleanTitle = fileName\n    .replace(/\\.pdf$/i, '')    // elimina .pdf al final\n    .replace(/[()]/g, '')      // elimina solo los paréntesis pero deja el contenido\n    .replace(/\\s+/g, ' ')      // limpia espacios múltiples\n    .trim();\n\n  // Limpiar texto: quitar saltos de línea y espacios de más\n  const text = item.json.text\n    ?.replace(/\\n/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  return {\n    Title: cleanTitle,\n    Path: path,\n    numpages: numpages,\n    Text: text\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        208
      ],
      "id": "11d9b682-84fa-41ef-b84e-5c7dbb2f1e6a",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const text = $json[\"Text\"] || \"\";\nconst chunkSize = 2000;     // tamaño de cada chunk\nconst overlap = 200;        // solapamiento entre chunks\nconst title = $input.first().json.Title;   // obtenemos el título\n\nlet chunks = [];\n\nif (text.trim().length === 0) {\n  // Si no hay texto, devolvemos un único chunk con \"imagen\"\n  chunks.push({ chunk: `Title: ${title}\\n\\nimagen` });\n} else {\n  for (let i = 0; i < text.length; i += (chunkSize - overlap)) {\n    let chunk = text.slice(i, i + chunkSize);\n\n    // si es el primer chunk, le añadimos el título\n    if (i === 0) {\n      chunk = `Title: ${title}\\n\\n${chunk}`;\n    }\n\n    chunks.push({ chunk });\n  }\n}\n\nreturn chunks.map(c => ({ json: c }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        208
      ],
      "id": "117e8475-ca08-4902-8958-e6cb9c4a41e8",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const text = $json[\"stdout\"] || \"\";\n\n// Dividir por saltos de línea y limpiar espacios vacíos\nconst lines = text\n  .split('\\n')\n  .map(line => line.trim())\n  .filter(line => line !== \"\");\n\n// Convertir cada línea en un chunk\nconst chunks = lines.map(line => ({ chunk: line }));\n\n// Retornar en formato que n8n espera\nreturn chunks.map(c => ({ json: c }));\n"
      },
      "type": "n8n-nodes-base.code",
